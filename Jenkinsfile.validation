pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Verify Repository Checkout') {
            steps {
                echo 'Verifying OpsPilot feature branch checkout...'

                sh '''
                    set -eu
                    test -f Jenkinsfile.validation
                    test -f configs/schemas/project.schema.json
                    test -f engine/project-config/package.json
                    test -f engine/project-config/package-lock.json

                    node --version
                    npm --version

                    echo "Repository checkout verified."
                '''
            }
        }

        stage('Install Project Config Dependencies') {
            steps {
                sh '''
                    set -eu
                    npm ci --prefix engine/project-config
                '''
            }
        }

        stage('Run Configuration Tests') {
            steps {
                sh '''
                    set -eu
                    npm --prefix engine/project-config test
                '''
            }
        }

        stage('Validate All Project Configurations') {
            steps {
                echo 'Discovering and validating all project configurations...'

                sh '''
                    set -eu

                    config_count=0

                    for config in configs/projects/*.yaml; do
                        if [ -f "$config" ]; then
                            config_count=$((config_count + 1))

                            echo ""
                            echo "========================================"
                            echo "Validating: $config"
                            echo "========================================"

                            npm --prefix engine/project-config run validate -- "$config"
                        fi
                    done

                    if [ "$config_count" -eq 0 ]; then
                        echo "ERROR: No project YAML configurations found."
                        exit 1
                    fi

                    echo ""
                    echo "Successfully validated $config_count project configuration(s)."
                '''
            }
        }
    }
    post {
        success {
            echo 'OpsPilot feature validation completed successfully.'
        }

        failure {
            echo 'OpsPilot feature validation failed. Review the stage logs.'
        }

        always {
            echo 'Validation pipeline finished.'
        }
    }
}
